# Configuración de Entorno para Hummailing
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-hummailing-key-2026
ALLOWED_HOSTS=localhost,127.0.0.1

# Resend API Key & Remitente por defecto
RESEND_API_KEY=re_your_resend_api_key_here
DEFAULT_FROM_EMAIL=Hummailing <hola@humm.cl>

# Despacho Asíncrono
# True: Hilos en segundo plano (recomendado en cPanel/Passenger sin Redis)
# False: Requiere servicio Redis y Celery worker activo
CELERY_TASK_ALWAYS_EAGER=True
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
